{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/binance/(.*)",
      "destination": "https://api.binance.com/$1"
    },
    {
      "source": "/api/fapi/(.*)",
      "destination": "https://fapi.binance.com/$1"
    },
    {
      "source": "/api/binance-vision/(.*)",
      "destination": "https://data-api.binance.vision/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
