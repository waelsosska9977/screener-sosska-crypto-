# =============================================================================
# SOSSKA1 QUANTITATIVE SCANNER CONFIGURATION (.env)
# =============================================================================

# Binance API Credentials (Optional for reading public Futures markets)
BINANCE_API_KEY=""
BINANCE_SECRET_KEY=""

# Telegram Bot Credentials (REQUIRED for alerts)
# 1. Get bot token from @BotFather on Telegram
# 2. Get your numeric chat ID from @userinfobot
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ"
TELEGRAM_CHAT_ID="987654321"

# Scan Scheduler Settings
SCAN_INTERVAL_MINUTES=15
TIMEFRAME="15m"

# Minimum 24h Trading Volume in USDT to filter out illiquid low-cap pairs
MIN_24H_VOLUME_USDT=5000000

# Cooldown duration in minutes to prevent repeated alerts for the same symbol & direction
COOLDOWN_MINUTES=90
